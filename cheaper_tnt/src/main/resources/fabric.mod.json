{
	"schemaVersion": 1,
	"id": "cheaper_tnt",
	"version": "${version}",
	"name": "cheaper_tnt",
	"description": "Makes TNT cheaper to craft (2 gunpowder + 2 sand in a criss-cross pattern), controlled by config.",
	"authors": [
		"Me!"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/cheaper_tnt/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"cheaper_tnt.Cheaper_tnt"
		],
		"client": [
			"cheaper_tnt.Cheaper_tntClient"
		]
	},
	"mixins": [
		"cheaper_tnt.mixins.json",
		{
			"config": "cheaper_tnt.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.18.4",
		"minecraft": "~1.21.10",
		"java": ">=21",
		"fabric-api": "*"
	}
}